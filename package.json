{
  "name": "tiers",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "A todo app with your own tiers, a backlog, and one-click suggestions from Claude.",
  "scripts": {
    "bundle": "esbuild src/backend.js --bundle --minify --format=iife --target=safari15,chrome100 --outfile=public/backend.js",
    "start": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "dist": "tauri build",
    "dist:mac": "tauri build --target universal-apple-darwin",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc",
    "test": "node --test test/*.test.js",
    "build:web": "node scripts/build-web.mjs",
    "test:cloud": "npx -y firebase-tools@13.35.1 emulators:exec --only auth,firestore --project demo-tiers \"node --test test/cloud/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.137.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "firebase": "^13.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "esbuild": "^0.28.2"
  },
  "productName": "Tiers",
  "author": "Nick"
}
