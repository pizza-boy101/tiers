{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tiers",
  "version": "1.1.0",
  "identifier": "com.nick.tiers",
  "build": {
    "frontendDist": "../public",
    "beforeBuildCommand": "npm run bundle",
    "beforeDevCommand": "npm run bundle"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tiers",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 620,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Productivity",
    "shortDescription": "Todo app with tiers and a backlog",
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
